# Copy to `.env` in the project root (never commit `.env`).
# Get a new key from https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional override (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# --- Frontend (production / preview builds) ---
# When building the Vite app for a hosted API (e.g. Render), set this to the API
# origin with NO trailing slash, then run: cd frontend && npm run build
# VITE_API_URL=https://your-api.onrender.com

# --- API (optional) ---
# Comma-separated extra CORS origins (e.g. your custom Vercel domain)
# CORS_EXTRA_ORIGINS=https://hireflow.example.com
